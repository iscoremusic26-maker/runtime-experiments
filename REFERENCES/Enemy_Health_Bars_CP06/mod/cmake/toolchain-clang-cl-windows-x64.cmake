# BARS203: cross-compile Windows x64 / MSVC ABI from Linux with clang-cl 21 + lld-link against the xwin CRT/SDK.
# Everything is project-local; set BARS203_TC to the toolchain directory (see toolchain/env.sh).
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(_tc "$ENV{BARS203_TC}")
if (NOT _tc)
    message(FATAL_ERROR "source toolchain/env.sh first (BARS203_TC is not set)")
endif ()
set(_llvm "${_tc}/llvm21/usr/lib/llvm-21/bin")
set(_w "${_tc}/winsdk")
set(CMAKE_C_COMPILER "${_llvm}/clang-cl")
set(CMAKE_CXX_COMPILER "${_llvm}/clang-cl")
set(CMAKE_LINKER "${_llvm}/lld-link")
set(CMAKE_AR "${_llvm}/llvm-lib")
set(CMAKE_RC_COMPILER "${_llvm}/llvm-rc")
set(CMAKE_MT "${_llvm}/llvm-mt")
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(_inc "/imsvc ${_w}/crt/include /imsvc ${_w}/sdk/include/ucrt /imsvc ${_w}/sdk/include/um /imsvc ${_w}/sdk/include/shared")
set(CMAKE_C_FLAGS_INIT "--target=x86_64-pc-windows-msvc ${_inc}")
set(CMAKE_CXX_FLAGS_INIT "--target=x86_64-pc-windows-msvc ${_inc} /EHsc")
set(_lib "/libpath:${_w}/crt/lib/x86_64 /libpath:${_w}/sdk/lib/um/x86_64 /libpath:${_w}/sdk/lib/ucrt/x86_64")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_lib}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_lib}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_lib}")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreadedDLL")
